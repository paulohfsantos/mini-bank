{
  "name": "@mini-banco/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Consumer SQS (NestJS standalone): antifraude e notificações (fase 3)",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc",
    "start": "node --enable-source-maps --import @mini-banco/observability/register dist/main.js",
    "dev": "node ../../scripts/dev-app.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dlq": "node --enable-source-maps --env-file-if-exists=../../.env dist/dlq/cli.js"
  },
  "devDependencies": {
    "@mini-banco/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1171.0",
    "@mini-banco/contracts": "workspace:*",
    "@mini-banco/database": "workspace:*",
    "@mini-banco/messaging": "workspace:*",
    "@mini-banco/observability": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
