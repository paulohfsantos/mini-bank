{
  "name": "@mini-banco/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Logger pino com redaction, correlationId (AsyncLocalStorage) e middleware HTTP; OpenTelemetry na fase 5",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/test-support/index.ts",
      "default": "./dist/test-support/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc"
  },
  "dependencies": {
    "@mini-banco/contracts": "workspace:*",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@mini-banco/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
