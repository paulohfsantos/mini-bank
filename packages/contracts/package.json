{
  "name": "@mini-banco/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contratos compartilhados: tipos gerados do openapi.yaml, schemas zod (API e eventos) e regras de formato",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript ../../specs/openapi.yaml -o src/generated/openapi.ts",
    "generate:check": "openapi-typescript ../../specs/openapi.yaml -o src/generated/openapi.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mini-banco/config": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:",
    "yaml": "^2.9.1"
  }
}
