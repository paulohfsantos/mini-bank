# Copie para .env (que não vai para o git). Valores abaixo são só para o ambiente local.

# Postgres (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minibanco
DB_USER=minibanco
DB_PASSWORD=minibanco-local
# dbmate (migrations rodam com o dono do banco)
DATABASE_URL=postgres://minibanco:minibanco-local@localhost:5432/minibanco?sslmode=disable
DBMATE_MIGRATIONS_DIR=db/migrations
# Usuários de aplicação com menor privilégio (migration 0002 + infra/local/postgres-init.sql)
API_DB_USER=mini_banco_api
API_DB_PASSWORD=api-local
WORKER_DB_USER=mini_banco_worker
WORKER_DB_PASSWORD=worker-local

# SQS via ElasticMQ (docker-compose; ADR-0022)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/mini-banco-transfer-events
SQS_DLQ_URL=http://localhost:9324/000000000000/mini-banco-transfer-events-dlq
# Relay do outbox dentro da API (OBX-BR-03)
OUTBOX_RELAY_ENABLED=true

# Worker (pool 5; concorrência ≤ pool, PERF-17)
WORKER_DB_POOL_MAX=5
WORKER_CONCURRENCY=5

# API
PORT=3001
LOG_LEVEL=info
DB_SSL=disable
# Clientes da API: clientId:chave, separados por vírgula (chave com 16+ caracteres)
API_KEYS=web:local-dev-key-0001
# Chave que o servidor Next usa para chamar a API (fase 4)
API_KEY=local-dev-key-0001

# OpenTelemetry -> Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

