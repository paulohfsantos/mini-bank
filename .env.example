# Copie para .env (que não vai para o git). Valores abaixo são só para o ambiente local.

# Postgres (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minibanco
DB_USER=minibanco
DB_PASSWORD=minibanco-local
# dbmate (fase 2)
DATABASE_URL=postgres://minibanco:minibanco-local@localhost:5432/minibanco?sslmode=disable

# SQS via ElasticMQ (docker-compose; ADR-0022)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/mini-banco-transfer-events

# API
API_KEY=local-dev-key

# OpenTelemetry -> Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

