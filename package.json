{
  "name": "mini-banco",
  "private": true,
  "type": "module",
  "description": "Laboratório Full Stack + AWS + Spec-Driven Development",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @mini-banco/api --filter @mini-banco/worker --filter @mini-banco/web --parallel dev",
    "test": "vitest run --project unit --passWithNoTests",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm specs:check",
    "specs:lint": "spectral lint specs/openapi.yaml --fail-severity=warn",
    "specs:coverage": "node scripts/specs-coverage.mjs",
    "specs:check": "pnpm specs:lint && pnpm contracts:check && pnpm specs:coverage --require=ACC,TRF,STM,OBX,PRC,WEB,OBS",
    "contracts:generate": "pnpm --filter @mini-banco/contracts generate",
    "contracts:check": "pnpm --filter @mini-banco/contracts generate:check",
    "db:migrate": "dbmate --no-dump-schema up && ./scripts/db-dump-schema.sh",
    "db:rollback": "dbmate --no-dump-schema rollback && ./scripts/db-dump-schema.sh",
    "db:new": "dbmate new",
    "infra:up": "docker compose up -d --wait",
    "infra:check": "./scripts/check-local-infra.sh",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "dev:api": "pnpm --filter @mini-banco/api dev",
    "dev:worker": "pnpm --filter @mini-banco/worker dev",
    "dlq:peek": "pnpm --filter '@mini-banco/worker...' build && pnpm --filter @mini-banco/worker run dlq peek",
    "dlq:redrive": "pnpm --filter '@mini-banco/worker...' build && pnpm --filter @mini-banco/worker run dlq redrive",
    "bench": "vitest run --project bench",
    "dev:web": "pnpm --filter @mini-banco/web dev",
    "test:web": "pnpm --filter '@mini-banco/api...' --filter '@mini-banco/web...' build && pnpm --filter @mini-banco/web test:e2e"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@mini-banco/config": "workspace:*",
    "@stoplight/spectral-cli": "^6.17.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/node": "catalog:",
    "dbmate": "^2.38.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.1.0"
  }
}
