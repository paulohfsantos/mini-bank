variable "name" {
  type = string
}

variable "subnet_ids" {
  type = list(string)
}

variable "security_group_id" {
  type = string
}

variable "engine_version" {
  type        = string
  default     = "17"
  description = "Versão principal igual à local (postgres:17.x); o RDS escolhe o minor."
}

variable "instance_class" {
  type    = string
  default = "db.t4g.micro"
}

variable "database_name" {
  type    = string
  default = "minibanco"
}
